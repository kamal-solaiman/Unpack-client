"""
uinotification.py - Unified Notification System

This module provides a centralized notification system for displaying
important game events to players in a non-intrusive, queued manner.

Notification Types:
- ITEM_EXPIRED: Realtime item expired (shows item icon + tooltip)
- AFFECT_EXPIRED: Buff/affect ended (shows custom icon from AFFECT_DATA_DICT)
- SYSTEM: General system message (shows custom/default icon)
- OFFLINE_SHOP: Offline shop events
- BATTLEPASS: Battle pass events
- MISSION: Daily/weekly mission events

Usage (from Python):
    import uinotification
    center = uinotification.NotificationCenter.GetInstance()
    if center:
        center.AddNotification(
            uinotification.NotificationType.SYSTEM,
            title="Title",
            message="Message",
            icon_path="d:/ymir work/ui/game/notification/system.sub"
        )

Server sends notifications via BINARY_NotificationReceived callback.
"""

import ui
import app
if app.ENABLE_WINDOW_RESIZE:
	from resizeexpr import Expr
import item
import wndMgr
import localeinfo
import chr

PATH = "d:/ymir work/ui/game/notification/"


def _GetBattlePassTitleTypes():
	"""Get TITLE_TYPES from uibattlepass at runtime to avoid import order issues."""
	try:
		import uibattlepass
		return uibattlepass.TITLE_TYPES
	except:
		return {}

def GetBattlePassMissionName(missionType):
	"""Get localized mission name for Battle Pass mission type."""
	TITLE_TYPES = _GetBattlePassTitleTypes()
	if missionType in TITLE_TYPES:
		return TITLE_TYPES[missionType]
	return localeinfo.NOTIFICATION_BP_MISSION_DEFAULT if hasattr(localeinfo, "NOTIFICATION_BP_MISSION_DEFAULT") else "Mission"


def _GetMissionQuestInfoTypes():
	"""Get INFO_TYPES from uimissionlist at runtime to avoid import order issues."""
	try:
		import uimissionlist
		return uimissionlist.INFO_TYPES
	except:
		return {}

def GetMissionQuestTypeName(missionType):
	"""Get localized mission name for Mission Quest type."""
	INFO_TYPES = _GetMissionQuestInfoTypes()
	if missionType in INFO_TYPES:
		return INFO_TYPES[missionType]
	return localeinfo.NOTIFICATION_MQ_MISSION_DEFAULT if hasattr(localeinfo, "NOTIFICATION_MQ_MISSION_DEFAULT") else "Mission"

#==========================================================================
# Affect Icon/Name Lookup from uiaffectshower.py
# This ensures consistent icons between the affect shower and notifications.
#==========================================================================

# Default affect icon if not found in map
DEFAULT_AFFECT_ICON = "d:/ymir work/ui/skill/common/affect/gold_premium.sub"


def _GetAffectDataDict():
	"""
	Get AFFECT_DATA_DICT from AffectShower at runtime.
	This deferred lookup avoids import order issues.
	"""
	try:
		import uiaffectshower
		return uiaffectshower.AffectShower.AFFECT_DATA_DICT
	except:
		return {}


def GetAffectIcon(affectType):
	"""
	Get icon path for an affect type from AFFECT_DATA_DICT.

	Args:
		affectType: The affect type constant (e.g., chr.AFFECT_HOSIN)

	Returns:
		str: Icon path for the affect, or DEFAULT_AFFECT_ICON if not found
	"""
	AFFECT_DATA_DICT = _GetAffectDataDict()
	if affectType in AFFECT_DATA_DICT:
		affectData = AFFECT_DATA_DICT[affectType]
		# affectData is tuple: (description, icon_path, [optional_scale, optional_offset])
		if len(affectData) >= 2:
			return affectData[1]
	return DEFAULT_AFFECT_ICON


def GetAffectName(affectType):
	"""
	Get localized name for an affect type from AFFECT_DATA_DICT.

	Args:
		affectType: The affect type constant (e.g., chr.AFFECT_HOSIN)

	Returns:
		str: Localized name for the affect, or "Effect" if not found
	"""
	AFFECT_DATA_DICT = _GetAffectDataDict()
	if affectType in AFFECT_DATA_DICT:
		affectData = AFFECT_DATA_DICT[affectType]
		# affectData[0] is either a string or a callable that returns a string
		nameOrFunc = affectData[0]
		if callable(nameOrFunc):
			try:
				return nameOrFunc(0)  # Pass 0 as default value for functions expecting a value
			except:
				return "Effect"
		return nameOrFunc
	return "Effect"

#==========================================================================
# Module-Level Notification History Storage
# Persists across NotificationCenter instance recreations (warp, logout)
# Only cleared when game client fully exits or user manually clears
#==========================================================================
_g_notificationHistory = []
_g_maxHistory = 20


class NotificationType:
	"""Notification type constants - must match server ENotificationType."""
	ITEM_EXPIRED = 0       # Realtime item expired (shows item icon + tooltip)
	AFFECT_EXPIRED = 1     # Buff/affect ended (shows custom icon)
	SYSTEM = 2             # System message (shows custom/default icon)
	OFFLINE_SHOP = 3       # Offline shop events
	BATTLEPASS = 4         # Battle pass events
	MISSION = 5            # Daily/weekly mission events
	ITEM_COLLECTED = 6     # Item received notification (shows item icon + count + tooltip)
	HORSE_UPGRADE = 7      # Horse upgrade mission events (success/failure/ready)


class NotificationPopup(ui.ScriptWindow):
	"""
	Displays individual notification popups.
	Refactored to display a SINGLE notification - multiple instances are stacked.

	Supports two display modes:
	1. Item-based: Shows item icon with tooltip on hover
	2. Icon-based: Shows custom icon without tooltip
	"""

	SHOW_TIME = 5       # Seconds to display each notification
	POPUP_HEIGHT = 95  # Height of each popup for stacking calculation
	POPUP_SPACING = 5   # Vertical spacing between stacked popups

	def __init__(self, slotIndex=0, onCloseCallback=None):
		ui.ScriptWindow.__init__(self)
		self.isLoaded = False
		self.slotIndex = slotIndex          # Which slot (0, 1, 2) this popup occupies
		self.onCloseCallback = onCloseCallback  # Called when notification dismissed
		self.currentNotification = None     # Single notification being displayed
		self.expireTime = 0                 # When this notification expires
		self.toolTipItem = None
		self.hasItemTooltip = False  # Whether current notification has item tooltip
		self.interface = None        # Reference to interface module for opening windows

		self.boardWidth = 0
		self.boardHeight = 0

		self.board = None
		self.boardWindow = None
		self.titleText = None
		self.messageText = None
		self.itemIcon = None
		self.notificationBg = None

		self.__LoadDialog()

	def __del__(self):
		ui.ScriptWindow.__del__(self)

	def SetInterface(self, interface):
		"""Set reference to interface module for opening windows on click."""
		self.interface = interface

	def __LoadDialog(self):
		if self.isLoaded:
			return

		self.isLoaded = True

		try:
			pyScrLoader = ui.PythonScriptLoader()
			pyScrLoader.LoadScriptFile(self, "uiscript/notification_popup.py")
		except:
			import exception
			exception.Abort("uinotification.NotificationPopup.__LoadDialog - LoadScriptFile Error")
			return
		self.AddFlag("movable")
		self.AddFlag("attach")
		self.AddFlag("float")
		if app.ENABLE_WINDOW_SLIDE_EFFECT:
			self.AddFlag("animated_scale")
			self.SetAnimationPreset("panel_left")

		# Position will be set by UpdateSlotPosition based on slotIndex
		self.UpdateSlotPosition()

		self.boardWidth = self.GetWidth()
		self.boardHeight = self.GetHeight()

		# Get UI elements
		self.board = self.GetChild("board")
		self.boardWindow = self.GetChild("board_window")
		self.titleText = self.GetChild("title_text")
		self.messageText = self.GetChild("message_text")
		self.itemIcon = self.GetChild("item_icon")
		self.NotificationBg = self.GetChild("notification_bg")
		self.countText = self.GetChild("count_text")
		self.countText.Hide()  # Hidden by default

		# Set events for item icon tooltip
		self.itemIcon.SetStringEvent("MOUSE_OVER_IN", ui.__mem_func__(self.OnOverIn))
		self.itemIcon.SetStringEvent("MOUSE_OVER_OUT", ui.__mem_func__(self.OnOverOut))

		self.board.Hide()
		self.SetSize(0, 0)

	def UpdateSlotPosition(self):
		"""Update position based on slot index (stacking from bottom)."""
		screenWidth = wndMgr.GetScreenWidth()
		screenHeight = wndMgr.GetScreenHeight()
		# Stack from bottom: slot 0 at bottom, slot 1 above, slot 2 at top
		baseY = screenHeight - 100 - 220
		yOffset = self.slotIndex * (self.POPUP_HEIGHT + self.POPUP_SPACING)
		self.SetPosition(130, baseY - yOffset)
		if app.ENABLE_WINDOW_RESIZE:
			self.SetResizeDic({"position" : (130, Expr("SCREEN_HEIGHT") - 100 - 220 - yOffset)})

	def SetSlotIndex(self, slotIndex):
		"""Change slot index and update position."""
		self.slotIndex = slotIndex
		self.UpdateSlotPosition()

	def IsAvailable(self):
		"""Check if this popup slot is available for a new notification."""
		return self.currentNotification is None

	def ShowNotification(self, notification):
		"""Display a single notification in this popup."""
		self.currentNotification = notification
		if self.Build():
			self.expireTime = app.GetGlobalTimeStamp() + self.SHOW_TIME
			self.SetSize(self.boardWidth, self.boardHeight)
			self.board.Show()
			self.Show()
			return True
		return False

	def Build(self):
		"""
		Build display for current notification.
		Handles item-based, affect-based, and icon-only notifications.
		"""
		notif = self.currentNotification
		if not notif:
			return False

		self.hasItemTooltip = False
		self.countText.Hide()  # Hide count text by default

		# Set dynamic background based on notification type
		self.NotificationBg.LoadImage(self._GenerateBgtype(notif))

		notifType = notif.get("type", 0)
		itemVnum = notif.get("item_vnum", 0)
		itemCount = notif.get("item_count", 1)
		iconPath = notif.get("icon_path", "")

		if notifType == NotificationType.ITEM_EXPIRED and itemVnum > 0:
			# Item-based notification: use item icon, enable tooltip
			item.SelectItem(itemVnum)
			self.itemIcon.LoadImage(item.GetIconImageFileName())
			self.hasItemTooltip = True
		elif notifType == NotificationType.ITEM_COLLECTED and itemVnum > 0:
			# Item collected notification: use item icon, enable tooltip, show count
			item.SelectItem(itemVnum)
			self.itemIcon.LoadImage(item.GetIconImageFileName())
			self.hasItemTooltip = True
			# Show count on icon if count > 1
			if itemCount > 1:
				self.countText.SetText("x%d" % itemCount)
				self.countText.Show()
		elif notifType == NotificationType.AFFECT_EXPIRED:
			# Affect-based notification: look up icon from AFFECT_DATA_DICT
			# Server sends affect_type via item_vnum field for this notification type
			affectType = itemVnum
			affectIcon = GetAffectIcon(affectType)
			self.itemIcon.LoadImage(affectIcon)
		elif iconPath:
			# Custom icon: use provided path, no tooltip
			self.itemIcon.LoadImage(iconPath)
		else:
			# Default system icon
			self.itemIcon.LoadImage("d:/ymir work/ui/game/notification/monthly.png")

		self.itemIcon.Show()

		# Set title and message
		notifType = notif.get("type", 0)
		title = notif.get("title", "")
		message = notif.get("message", "")

		needsGeneration = notifType in (NotificationType.BATTLEPASS, NotificationType.MISSION,
										NotificationType.ITEM_EXPIRED, NotificationType.AFFECT_EXPIRED,
										NotificationType.ITEM_COLLECTED, NotificationType.HORSE_UPGRADE)

		if not title or needsGeneration:
			title = self._GenerateTitle(notif)
		if not message or needsGeneration:
			message = self._GenerateMessage(notif)

		self.titleText.SetText(title)
		self.messageText.SetText(message)

		return True

	def _GenerateBgtype(self, notif):
		notifType = notif.get("type", 0)

		if notifType == NotificationType.ITEM_EXPIRED:
			return PATH + "quest_any_frame.png"
		elif notifType == NotificationType.ITEM_COLLECTED:
			return PATH + "event_frame.png"  # Celebratory frame for rewards
		elif notifType == NotificationType.AFFECT_EXPIRED:
			return PATH + "monthly_frame.png"
		elif notifType == NotificationType.SYSTEM:
			return PATH + "questline_frame.png"
		elif notifType == NotificationType.OFFLINE_SHOP:
			return PATH + "quest_any_frame.png"  # Shop notifications
		elif notifType == NotificationType.BATTLEPASS:
			return PATH + "event_frame.png"
		elif notifType == NotificationType.MISSION:
			return PATH + "quest_unique_frame.png"
		elif notifType == NotificationType.HORSE_UPGRADE:
			return PATH + "event_frame.png"

		return PATH + "quest_any_frame.png"

	def _GenerateTitle(self, notif):
		"""Generate title based on notification type if not provided by server."""
		notifType = notif.get("type", 0)
		serverMessage = notif.get("message", "")

		if notifType == NotificationType.ITEM_EXPIRED:
			return localeinfo.NOTIFICATION_ITEM_EXPIRED_TITLE
		elif notifType == NotificationType.ITEM_COLLECTED:
			return localeinfo.NOTIFICATION_ITEM_COLLECTED_TITLE if hasattr(localeinfo, "NOTIFICATION_ITEM_COLLECTED_TITLE") else "Item Received"
		elif notifType == NotificationType.AFFECT_EXPIRED:
			return localeinfo.NOTIFICATION_AFFECT_EXPIRED_TITLE
		elif notifType == NotificationType.SYSTEM:
			return localeinfo.NOTIFICATION_SYSTEM_TITLE
		elif notifType == NotificationType.OFFLINE_SHOP:
			return localeinfo.NOTIFICATION_OFFLINE_SHOP_TITLE
		elif notifType == NotificationType.BATTLEPASS:
			# Parse sub-type from message: "L" = Level up, "M:exp" = Mission done, "R:weekly" = Reset
			return self._GenerateBattlePassTitle(serverMessage)
		elif notifType == NotificationType.MISSION:
			# Parse sub-type from message: "C" = Complete, "R:weekly" = Reset
			return self._GenerateMissionQuestTitle(serverMessage)
		elif notifType == NotificationType.HORSE_UPGRADE:
			return self._GenerateHorseUpgradeTitle(serverMessage)

		return "Notification"

	def _GenerateBattlePassTitle(self, serverMessage):
		"""Generate title for Battle Pass notifications based on sub-type."""
		if serverMessage.startswith("L"):
			return localeinfo.NOTIFICATION_BP_LEVELUP_TITLE if hasattr(localeinfo, "NOTIFICATION_BP_LEVELUP_TITLE") else "Battle Pass"
		elif serverMessage.startswith("M"):
			return localeinfo.NOTIFICATION_BP_MISSION_TITLE if hasattr(localeinfo, "NOTIFICATION_BP_MISSION_TITLE") else "Mission Complete"
		elif serverMessage.startswith("R"):
			return localeinfo.NOTIFICATION_BP_RESET_TITLE if hasattr(localeinfo, "NOTIFICATION_BP_RESET_TITLE") else "Missions Reset"
		return localeinfo.NOTIFICATION_BATTLEPASS_TITLE

	def _GenerateMissionQuestTitle(self, serverMessage):
		"""Generate title for Mission Quest notifications based on sub-type."""
		if serverMessage.startswith("C"):
			return localeinfo.NOTIFICATION_MQ_COMPLETE_TITLE if hasattr(localeinfo, "NOTIFICATION_MQ_COMPLETE_TITLE") else "Mission Complete"
		elif serverMessage.startswith("R"):
			return localeinfo.NOTIFICATION_MQ_RESET_TITLE if hasattr(localeinfo, "NOTIFICATION_MQ_RESET_TITLE") else "Missions Reset"
		return localeinfo.NOTIFICATION_MISSION_TITLE

	def _GenerateMessage(self, notif):
		"""Generate message based on notification type if not provided by server."""
		notifType = notif.get("type", 0)
		itemVnum = notif.get("item_vnum", 0)
		itemCount = notif.get("item_count", 1)
		serverMessage = notif.get("message", "")

		if notifType == NotificationType.ITEM_EXPIRED and itemVnum > 0:
			item.SelectItem(itemVnum)
			return localeinfo.NOTIFICATION_ITEM_EXPIRED_MSG % item.GetItemName()

		elif notifType == NotificationType.ITEM_COLLECTED and itemVnum > 0:
			item.SelectItem(itemVnum)
			itemName = item.GetItemName()
			if itemCount > 1:
				if hasattr(localeinfo, "NOTIFICATION_ITEM_COLLECTED_MSG_COUNT"):
					return localeinfo.NOTIFICATION_ITEM_COLLECTED_MSG_COUNT % (itemName, itemCount)
				return "You received %s x%d" % (itemName, itemCount)
			else:
				if hasattr(localeinfo, "NOTIFICATION_ITEM_COLLECTED_MSG"):
					return localeinfo.NOTIFICATION_ITEM_COLLECTED_MSG % itemName
				return "You received %s" % itemName

		elif notifType == NotificationType.AFFECT_EXPIRED:
			# Server sends affect_type via item_vnum field for this notification type
			affectType = itemVnum
			affectName = GetAffectName(affectType)
			return localeinfo.NOTIFICATION_AFFECT_EXPIRED_MSG % affectName

		elif notifType == NotificationType.BATTLEPASS:
			# Parse sub-type and generate localized message
			return self._GenerateBattlePassMessage(serverMessage, itemVnum, itemCount)

		elif notifType == NotificationType.MISSION:
			# Parse sub-type and generate localized message
			return self._GenerateMissionQuestMessage(serverMessage, itemVnum, itemCount)
		elif notifType == NotificationType.HORSE_UPGRADE:
			return self._GenerateHorseUpgradeMessage(serverMessage, itemVnum)

		return serverMessage

	def _GenerateBattlePassMessage(self, serverMessage, itemVnum, itemCount):
		"""
		Generate localized Battle Pass notification message.

		Server encoding:
		- "L" = Level up, itemVnum = new level
		- "M:<exp>" = Mission done, itemVnum = mission_type, itemCount = category
		- "R:<is_weekly>" = Reset, 0 = daily, 1 = weekly
		"""
		if serverMessage.startswith("L"):
			# Level up notification
			level = itemVnum
			if hasattr(localeinfo, "NOTIFICATION_BP_LEVELUP_MSG"):
				return localeinfo.NOTIFICATION_BP_LEVELUP_MSG % level
			return "You have reached level %d!" % level

		elif serverMessage.startswith("M:"):
			# Mission done notification
			try:
				expGained = int(serverMessage.split(":")[1])
			except:
				expGained = 0
			missionType = itemVnum
			missionName = GetBattlePassMissionName(missionType)
			if hasattr(localeinfo, "NOTIFICATION_BP_MISSION_MSG"):
				return localeinfo.NOTIFICATION_BP_MISSION_MSG % (missionName, expGained)
			return "'%s' completed! +%d EXP" % (missionName, expGained)

		elif serverMessage.startswith("R:"):
			# Reset notification
			try:
				isWeekly = serverMessage.split(":")[1] == "1"
			except:
				isWeekly = False
			if isWeekly:
				return localeinfo.NOTIFICATION_BP_RESET_WEEKLY_MSG if hasattr(localeinfo, "NOTIFICATION_BP_RESET_WEEKLY_MSG") else "Weekly missions have been reset!"
			else:
				return localeinfo.NOTIFICATION_BP_RESET_DAILY_MSG if hasattr(localeinfo, "NOTIFICATION_BP_RESET_DAILY_MSG") else "Daily missions have been reset!"

		return serverMessage

	def _GenerateMissionQuestMessage(self, serverMessage, itemVnum, itemCount):
		"""
		Generate localized Mission Quest notification message.

		Server encoding:
		- "C" = Complete, itemVnum = mission_type, itemCount = is_weekly (0/1)
		- "R:<is_weekly>" = Reset, 0 = daily, 1 = weekly
		"""
		if serverMessage.startswith("C"):
			# Mission complete notification
			missionType = itemVnum
			isWeekly = itemCount == 1
			missionName = GetMissionQuestTypeName(missionType)

			# Get category name based on isWeekly flag
			if isWeekly:
				categoryName = localeinfo.NOTIFICATION_MQ_WEEKLY if hasattr(localeinfo, "NOTIFICATION_MQ_WEEKLY") else "Weekly"
			else:
				categoryName = localeinfo.NOTIFICATION_MQ_DAILY if hasattr(localeinfo, "NOTIFICATION_MQ_DAILY") else "Daily"

			if hasattr(localeinfo, "NOTIFICATION_MQ_COMPLETE_MSG"):
				return localeinfo.NOTIFICATION_MQ_COMPLETE_MSG % (categoryName, missionName)
			return "%s mission '%s' completed!" % (categoryName, missionName)

		elif serverMessage.startswith("R:"):
			# Reset notification
			try:
				isWeekly = serverMessage.split(":")[1] == "1"
			except:
				isWeekly = False
			if isWeekly:
				return localeinfo.NOTIFICATION_MQ_RESET_WEEKLY_MSG if hasattr(localeinfo, "NOTIFICATION_MQ_RESET_WEEKLY_MSG") else "Weekly missions have been reset!"
			else:
				return localeinfo.NOTIFICATION_MQ_RESET_DAILY_MSG if hasattr(localeinfo, "NOTIFICATION_MQ_RESET_DAILY_MSG") else "Daily missions have been reset!"

	def _GenerateHorseUpgradeTitle(self, serverMessage):
		"""Generate title for Horse Upgrade notifications based on sub-type."""
		if serverMessage.startswith("S"):
			return localeinfo.NOTIFICATION_HORSE_UPGRADE_SUCCESS_TITLE if hasattr(localeinfo, "NOTIFICATION_HORSE_UPGRADE_SUCCESS_TITLE") else "Horse Mission Succeeded"
		elif serverMessage.startswith("F"):
			return localeinfo.NOTIFICATION_HORSE_UPGRADE_FAILURE_TITLE if hasattr(localeinfo, "NOTIFICATION_HORSE_UPGRADE_FAILURE_TITLE") else "Horse Mission Failed"
		elif serverMessage.startswith("R"):
			return localeinfo.NOTIFICATION_HORSE_UPGRADE_READY_TITLE if hasattr(localeinfo, "NOTIFICATION_HORSE_UPGRADE_READY_TITLE") else "Horse Training Ready"
		return localeinfo.NOTIFICATION_HORSE_UPGRADE_TITLE if hasattr(localeinfo, "NOTIFICATION_HORSE_UPGRADE_TITLE") else "Horse Upgrade"

	def _GenerateHorseUpgradeMessage(self, serverMessage, itemVnum):
		"""
		Generate localized Horse Upgrade notification message.

		Server encoding:
		- "S:<level>" = Mission success, itemVnum = new horse level
		- "F"         = Mission failure
		- "R"         = Cooldown ended, next mission ready
		"""
		if serverMessage.startswith("S"):
			# Prefer the level encoded in the message body; fall back to itemVnum.
			try:    level = int(serverMessage.split(":")[1])
			except: level = itemVnum
			if hasattr(localeinfo, "NOTIFICATION_HORSE_UPGRADE_SUCCESS_MSG"):
				return localeinfo.NOTIFICATION_HORSE_UPGRADE_SUCCESS_MSG % level
			return "Your horse advanced to level %d." % level
		elif serverMessage.startswith("F"):
			return localeinfo.NOTIFICATION_HORSE_UPGRADE_FAILURE_MSG if hasattr(localeinfo, "NOTIFICATION_HORSE_UPGRADE_FAILURE_MSG") else "Try again after cooldown."
		elif serverMessage.startswith("R"):
			return localeinfo.NOTIFICATION_HORSE_UPGRADE_READY_MSG if hasattr(localeinfo, "NOTIFICATION_HORSE_UPGRADE_READY_MSG") else "You can start the next mission."
		return serverMessage

		return serverMessage

	def OnUpdate(self):
		"""Timer-based auto-dismiss logic for single notification."""
		if self.currentNotification is None:
			return

		timeNow = app.GetGlobalTimeStamp()

		# Check if current notification has expired
		if timeNow > self.expireTime:
			self._DismissNotification()

	def _DismissNotification(self):
		"""Internal method to dismiss the current notification."""
		notification = self.currentNotification
		self.currentNotification = None
		self.expireTime = 0
		self.hasItemTooltip = False
		self.countText.Hide()
		self.board.Hide()
		self.SetSize(0, 0)
		self.Hide()  # Hide the ScriptWindow itself

		# Notify the center that this slot is now free
		if self.onCloseCallback:
			self.onCloseCallback(self.slotIndex, notification)

	def __OnClose(self):
		"""Manual close button handler."""
		self._DismissNotification()

	def OnMouseLeftButtonUp(self):
		"""
		Click handler to open the related system window.
		This method is called automatically by the UI framework when the window is clicked.
		"""
		if not self.interface:
			return

		if not self.currentNotification:
			return

		notifType = self.currentNotification.get("type", 0)

		# Open the appropriate window based on notification type
		if notifType == NotificationType.BATTLEPASS:
			if app.ADVANCED_BATTLE_PASS and hasattr(self.interface, "ShowBattlePass"):
				self.interface.ShowBattlePass()
		elif notifType == NotificationType.MISSION:
			if app.ENABLE_MISSION_QUEST and hasattr(self.interface, "ToggleMissionQuest"):
				self.interface.ToggleMissionQuest()
		elif notifType == NotificationType.HORSE_UPGRADE:
			if app.ENABLE_HORSE_UPGRADE and hasattr(self.interface, "ToggleHorseUpgrade"):
				self.interface.ToggleHorseUpgrade()

		# Close this notification after clicking
		self.__OnClose()

	def OnOverIn(self):
		"""Show tooltip ONLY for item-based notifications."""
		if not self.hasItemTooltip:
			return

		if not self.currentNotification:
			return

		itemVnum = self.currentNotification.get("item_vnum", 0)
		if itemVnum <= 0:
			return

		if not self.toolTipItem:
			import uitooltip
			self.toolTipItem = uitooltip.ItemToolTip()

		self.toolTipItem.ClearToolTip()
		self.toolTipItem.SetItemToolTip(itemVnum)

	def OnOverOut(self):
		"""Hide tooltip."""
		if self.toolTipItem:
			self.toolTipItem.HideToolTip()

	def Close(self):
		if self.toolTipItem:
			self.toolTipItem.HideToolTip()
		self.Hide()

	def Destroy(self):
		self.currentNotification = None
		self.expireTime = 0
		self.hasItemTooltip = False
		self.onCloseCallback = None
		if self.toolTipItem:
			del self.toolTipItem
			self.toolTipItem = None
		self.board = None
		self.boardWindow = None
		self.titleText = None
		self.messageText = None
		self.itemIcon = None
		self.countText = None
		self.ClearDictionary()


class NotificationHistoryItem(ui.Window):
	"""Individual history entry display - Type Icon | Notification | Time"""

	ITEM_WIDTH = 380
	ITEM_HEIGHT = 45

	# Column positions (LTR layout)
	COL_TYPE_X = 5       # Type/Icon column
	COL_TYPE_WIDTH = 40
	COL_NOTIF_X = 50     # Notification text column
	COL_NOTIF_WIDTH = 230
	COL_TIME_X = 290     # Time column
	COL_TIME_WIDTH = 85

	def __init__(self):
		ui.Window.__init__(self)
		self.SetSize(self.ITEM_WIDTH, self.ITEM_HEIGHT)

		self.notification = None
		self.tooltipItem = None
		self.hasItemTooltip = False

		self._CreateUI()

	def _CreateUI(self):
		isArabic = localeinfo.IsARABIC() if hasattr(localeinfo, "IsARABIC") else False

		# Simple ThinBoard background for each item
		self.bgBoard = ui.OutlineWindow()
		self.bgBoard.SetParent(self)
		self.bgBoard.MakeOutlineWindow(self.ITEM_WIDTH - 4, self.ITEM_HEIGHT - 4)
		self.bgBoard.SetPosition(2, 2)
		self.bgBoard.Show()

		# Vertical center offset for text and icon (item height is 45, text/icon should be centered)
		TEXT_Y = 14
		ICON_Y = 6

		if isArabic:
			# RTL layout: [Time] [Notification] [Type Icon]
			# Time - far left
			self.textTime = ui.TextLine()
			self.textTime.SetParent(self)
			self.textTime.SetPosition(75, TEXT_Y)
			self.textTime.SetHorizontalAlignLeft()
			self.textTime.SetPackedFontColor(0xFFAAAAAA)
			self.textTime.SetOutline()
			self.textTime.Show()

			# Notification text - center
			self.textMessage = ui.TextLine()
			self.textMessage.SetParent(self)
			self.textMessage.SetPosition(self.ITEM_WIDTH - 90, TEXT_Y)
			self.textMessage.SetHorizontalAlignLeft()
			self.textMessage.SetOutline()
			self.textMessage.SetPackedFontColor(0xFFfad390)
			self.textMessage.Show()

			# Type Icon - far right
			self.icon = ui.ExpandedImageBox()
			self.icon.SetParent(self)
			self.icon.SetPosition(self.ITEM_WIDTH - 45, ICON_Y)
			self.icon.SetStringEvent("MOUSE_OVER_IN", ui.__mem_func__(self.OnOverIn))
			self.icon.SetStringEvent("MOUSE_OVER_OUT", ui.__mem_func__(self.OnOverOut))
			self.icon.Show()
		else:
			# LTR layout: [Type Icon] [Notification] [Time]
			# Type Icon - far left
			self.icon = ui.ExpandedImageBox()
			self.icon.SetParent(self)
			self.icon.SetPosition(self.COL_TYPE_X, ICON_Y)
			self.icon.SetStringEvent("MOUSE_OVER_IN", ui.__mem_func__(self.OnOverIn))
			self.icon.SetStringEvent("MOUSE_OVER_OUT", ui.__mem_func__(self.OnOverOut))
			self.icon.Show()

			# Notification text - center
			self.textMessage = ui.TextLine()
			self.textMessage.SetParent(self)
			self.textMessage.SetPosition(self.COL_NOTIF_X, TEXT_Y)
			self.textMessage.SetOutline()
			self.textMessage.Show()

			# Time - far right
			self.textTime = ui.TextLine()
			self.textTime.SetParent(self)
			self.textTime.SetPosition(self.COL_TIME_X, TEXT_Y)
			self.textTime.SetHorizontalAlignLeft()
			self.textTime.SetPackedFontColor(0xFFAAAAAA)
			self.textTime.SetOutline()
			self.textTime.Show()

	def SetItemToolTip(self, tooltip):
		self.tooltipItem = tooltip

	def SetData(self, notification):
		"""Populate from notification dict."""
		self.notification = notification
		self.hasItemTooltip = False

		notifType = notification.get("type", 0)
		itemVnum = notification.get("item_vnum", 0)
		iconPath = notification.get("icon_path", "")

		# Determine icon
		if notifType == NotificationType.ITEM_EXPIRED and itemVnum > 0:
			item.SelectItem(itemVnum)
			self.icon.LoadImage(item.GetIconImageFileName())
			self.hasItemTooltip = True
		elif notifType == NotificationType.ITEM_COLLECTED and itemVnum > 0:
			item.SelectItem(itemVnum)
			self.icon.LoadImage(item.GetIconImageFileName())
			self.hasItemTooltip = True
		elif notifType == NotificationType.AFFECT_EXPIRED:
			affectType = itemVnum
			affectIcon = GetAffectIcon(affectType)
			self.icon.LoadImage(affectIcon)
		elif iconPath:
			self.icon.LoadImage(iconPath)
		else:
			self.icon.LoadImage("d:/ymir work/ui/game/notification/monthly.png")

		# Generate display text - always use _GenerateDisplayText for proper formatting
		displayText = self._GenerateDisplayText(notification)

		# Truncate if too long
		if len(displayText) > 45:
			displayText = displayText[:42] + "..."

		self.textMessage.SetText(displayText)

		# Update time
		self.UpdateTime()

	def _GenerateDisplayText(self, notification):
		"""Generate display text based on notification type."""
		notifType = notification.get("type", 0)
		itemVnum = notification.get("item_vnum", 0)
		itemCount = notification.get("item_count", 0)
		serverMessage = notification.get("message", "")

		if notifType == NotificationType.ITEM_EXPIRED and itemVnum > 0:
			item.SelectItem(itemVnum)
			expiredText = localeinfo.NOTIFICATION_HISTORY_ITEM_EXPIRED if hasattr(localeinfo, "NOTIFICATION_HISTORY_ITEM_EXPIRED") else "%s expired"
			return expiredText % item.GetItemName()

		elif notifType == NotificationType.ITEM_COLLECTED and itemVnum > 0:
			item.SelectItem(itemVnum)
			itemName = item.GetItemName()
			if itemCount > 1:
				collectedText = localeinfo.NOTIFICATION_HISTORY_ITEM_COLLECTED_COUNT if hasattr(localeinfo, "NOTIFICATION_HISTORY_ITEM_COLLECTED_COUNT") else "Received %s x%d"
				return collectedText % (itemName, itemCount)
			else:
				collectedText = localeinfo.NOTIFICATION_HISTORY_ITEM_COLLECTED if hasattr(localeinfo, "NOTIFICATION_HISTORY_ITEM_COLLECTED") else "Received %s"
				return collectedText % itemName

		elif notifType == NotificationType.AFFECT_EXPIRED:
			affectType = itemVnum
			affectName = GetAffectName(affectType)
			endedText = localeinfo.NOTIFICATION_HISTORY_AFFECT_ENDED if hasattr(localeinfo, "NOTIFICATION_HISTORY_AFFECT_ENDED") else "%s ended"
			return endedText % affectName

		elif notifType == NotificationType.SYSTEM:
			# Use stored message/title if available
			storedTitle = notification.get("title", "")
			storedMsg = notification.get("message", "")
			if storedMsg:
				return storedMsg
			elif storedTitle:
				return storedTitle
			return localeinfo.NOTIFICATION_HISTORY_SYSTEM if hasattr(localeinfo, "NOTIFICATION_HISTORY_SYSTEM") else "System notification"

		elif notifType == NotificationType.BATTLEPASS:
			# Parse the server message to generate proper display text
			return self._GenerateBattlePassDisplayText(serverMessage, itemVnum, itemCount)

		elif notifType == NotificationType.MISSION:
			# Parse the server message to generate proper display text
			return self._GenerateMissionDisplayText(serverMessage, itemVnum, itemCount)

		elif notifType == NotificationType.HORSE_UPGRADE:
			return self._GenerateHorseUpgradeDisplayText(serverMessage, itemVnum)

		return "Notification"

	def _GenerateBattlePassDisplayText(self, serverMessage, itemVnum, itemCount):
		"""Generate Battle Pass display text for history."""
		if serverMessage.startswith("L"):
			# Level up: itemVnum = new level
			level = itemVnum
			levelUpText = localeinfo.NOTIFICATION_HISTORY_BP_LEVELUP if hasattr(localeinfo, "NOTIFICATION_HISTORY_BP_LEVELUP") else "Reached BP Level %d"
			return levelUpText % level

		elif serverMessage.startswith("M:"):
			# Mission done: itemVnum = mission_type
			try:
				expGained = int(serverMessage.split(":")[1])
			except:
				expGained = 0
			missionType = itemVnum
			missionName = GetBattlePassMissionName(missionType)
			missionText = localeinfo.NOTIFICATION_HISTORY_BP_MISSION if hasattr(localeinfo, "NOTIFICATION_HISTORY_BP_MISSION") else "%s (+%d EXP)"
			return missionText % (missionName, expGained)

		elif serverMessage.startswith("R:"):
			# Reset notification
			try:
				isWeekly = serverMessage.split(":")[1] == "1"
			except:
				isWeekly = False
			if isWeekly:
				return localeinfo.NOTIFICATION_HISTORY_BP_RESET_WEEKLY if hasattr(localeinfo, "NOTIFICATION_HISTORY_BP_RESET_WEEKLY") else "Weekly BP missions reset"
			else:
				return localeinfo.NOTIFICATION_HISTORY_BP_RESET_DAILY if hasattr(localeinfo, "NOTIFICATION_HISTORY_BP_RESET_DAILY") else "Daily BP missions reset"

		return localeinfo.NOTIFICATION_HISTORY_BATTLEPASS if hasattr(localeinfo, "NOTIFICATION_HISTORY_BATTLEPASS") else "Battle Pass"

	def _GenerateMissionDisplayText(self, serverMessage, itemVnum, itemCount):
		"""Generate Mission Quest display text for history."""
		if serverMessage.startswith("C"):
			# Mission complete: itemVnum = mission_type, itemCount = is_weekly
			missionType = itemVnum
			isWeekly = itemCount == 1
			missionName = GetMissionQuestTypeName(missionType)

			if isWeekly:
				categoryName = localeinfo.NOTIFICATION_MQ_WEEKLY if hasattr(localeinfo, "NOTIFICATION_MQ_WEEKLY") else "Weekly"
			else:
				categoryName = localeinfo.NOTIFICATION_MQ_DAILY if hasattr(localeinfo, "NOTIFICATION_MQ_DAILY") else "Daily"

			missionText = localeinfo.NOTIFICATION_HISTORY_MQ_COMPLETE if hasattr(localeinfo, "NOTIFICATION_HISTORY_MQ_COMPLETE") else "%s: %s"
			return missionText % (categoryName, missionName)

		elif serverMessage.startswith("R:"):
			# Reset notification
			try:
				isWeekly = serverMessage.split(":")[1] == "1"
			except:
				isWeekly = False
			if isWeekly:
				return localeinfo.NOTIFICATION_HISTORY_MQ_RESET_WEEKLY if hasattr(localeinfo, "NOTIFICATION_HISTORY_MQ_RESET_WEEKLY") else "Weekly missions reset"
			else:
				return localeinfo.NOTIFICATION_HISTORY_MQ_RESET_DAILY if hasattr(localeinfo, "NOTIFICATION_HISTORY_MQ_RESET_DAILY") else "Daily missions reset"

		return localeinfo.NOTIFICATION_HISTORY_MISSION if hasattr(localeinfo, "NOTIFICATION_HISTORY_MISSION") else "Mission Quest"

	def _GenerateHorseUpgradeDisplayText(self, serverMessage, itemVnum):
		"""Generate Horse Upgrade display text for history."""
		if serverMessage.startswith("S"):
			try:    level = int(serverMessage.split(":")[1])
			except: level = itemVnum
			fmt = localeinfo.NOTIFICATION_HISTORY_HORSE_UPGRADE_SUCCESS if hasattr(localeinfo, "NOTIFICATION_HISTORY_HORSE_UPGRADE_SUCCESS") else "Horse advanced to level %d"
			return fmt % level
		elif serverMessage.startswith("F"):
			return localeinfo.NOTIFICATION_HISTORY_HORSE_UPGRADE_FAILURE if hasattr(localeinfo, "NOTIFICATION_HISTORY_HORSE_UPGRADE_FAILURE") else "Horse mission failed"
		elif serverMessage.startswith("R"):
			return localeinfo.NOTIFICATION_HISTORY_HORSE_UPGRADE_READY if hasattr(localeinfo, "NOTIFICATION_HISTORY_HORSE_UPGRADE_READY") else "Horse training ready"
		return localeinfo.NOTIFICATION_HISTORY_HORSE_UPGRADE if hasattr(localeinfo, "NOTIFICATION_HISTORY_HORSE_UPGRADE") else "Horse Upgrade"

	def UpdateTime(self):
		"""Update relative time display."""
		if not self.notification:
			return

		timestamp = self.notification.get("timestamp", 0)
		if timestamp == 0:
			self.textTime.SetText("")
			return

		currentTime = app.GetGlobalTimeStamp()
		elapsed = currentTime - timestamp

		timeText = self._FormatRelativeTime(elapsed)
		self.textTime.SetText(timeText)

	def _FormatRelativeTime(self, seconds):
		"""Format seconds as relative time string."""
		if seconds < 0:
			seconds = 0

		if seconds < 60:
			# X seconds ago
			return localeinfo.NOTIFICATION_TIME_SECONDS % seconds if hasattr(localeinfo, "NOTIFICATION_TIME_SECONDS") else "%d sec ago" % seconds
		elif seconds < 3600:
			# X minutes ago
			minutes = seconds / 60
			return localeinfo.NOTIFICATION_TIME_MINUTES % minutes if hasattr(localeinfo, "NOTIFICATION_TIME_MINUTES") else "%d min ago" % minutes
		else:
			# X hours ago
			hours = seconds / 3600
			return localeinfo.NOTIFICATION_TIME_HOURS % hours if hasattr(localeinfo, "NOTIFICATION_TIME_HOURS") else "%d hr ago" % hours

	def OnOverIn(self):
		"""Show tooltip for item-based notifications."""
		if not self.hasItemTooltip or not self.notification:
			return

		itemVnum = self.notification.get("item_vnum", 0)
		if itemVnum <= 0:
			return

		if self.tooltipItem:
			self.tooltipItem.ClearToolTip()
			self.tooltipItem.SetItemToolTip(itemVnum)

	def OnOverOut(self):
		"""Hide tooltip."""
		if self.tooltipItem:
			self.tooltipItem.HideToolTip()

	def Destroy(self):
		self.notification = None
		self.tooltipItem = None
		self.bgBoard = None


class NotificationHistoryWindow(ui.ScriptWindow):
	"""Window displaying recent notification history with scrollable list."""

	VISIBLE_ITEMS = 4
	ITEM_HEIGHT = 45
	MAX_HISTORY = 20
	TIME_UPDATE_INTERVAL = 1.0  # Update relative times every second

	# Header bar positioning
	HEADER_Y = 32
	HEADER_HEIGHT = 25
	LIST_Y = HEADER_Y + HEADER_HEIGHT

	# Column positions for header labels (should match NotificationHistoryItem)
	COL_TYPE_X = 5
	COL_NOTIF_X = 50
	COL_TIME_X = 290

	def __init__(self):
		ui.ScriptWindow.__init__(self)
		self.isLoaded = False

		self.historyItems = []
		self.scrollBar = None
		self.basePos = 0
		self.tooltipItem = None
		self.lastTimeUpdate = 0

		self.__LoadDialog()

	def __del__(self):
		ui.ScriptWindow.__del__(self)

	def __LoadDialog(self):
		if self.isLoaded:
			return

		self.isLoaded = True

		try:
			pyScrLoader = ui.PythonScriptLoader()
			pyScrLoader.LoadScriptFile(self, "uiscript/notification_history.py")
		except:
			import exception
			exception.Abort("NotificationHistoryWindow.__LoadDialog - LoadScriptFile Error")
			return

		self.AddFlag("movable")
		self.AddFlag("float")
		if app.ENABLE_WINDOW_SLIDE_EFFECT:
			self.AddFlag("animated_board")
		# Center on screen
		screenWidth = wndMgr.GetScreenWidth()
		screenHeight = wndMgr.GetScreenHeight()
		windowWidth = self.GetWidth()
		windowHeight = self.GetHeight()
		

		
		self.SetPosition((screenWidth - windowWidth) / 2, (screenHeight - windowHeight) / 2)

		# Get UI elements
		self.board = self.GetChild("board")
		self.headerBg = self.GetChild("header_bg")
		self.listContainer = self.GetChild("list_container")
		self.emptyText = self.GetChild("empty_text")
		self.btnClear = self.GetChild("btn_clear")

		self.bgWnd = ui.ThinBoard("UI",2)
		self.bgWnd.SetParent(self.board )
		self.bgWnd.SetSize(self.board.GetWidth() - 20 ,self.board.GetHeight() - 45)
		self.bgWnd.SetPosition(10,33)
		self.bgWnd.Show()

		# Create header bar background and labels
		self._CreateHeaderBar()

		# Setup scrollbar (position adjusted for new layout)
		self.scrollBar = ui.ScrollBarNew()
		self.scrollBar.SetParent(self)
		self.scrollBar.SetPosition(self.GetWidth() - 25, self.LIST_Y + 25)
		self.scrollBar.SetScrollBarSize(self.ITEM_HEIGHT * self.VISIBLE_ITEMS)
		self.scrollBar.SetScrollEvent(ui.__mem_func__(self.OnScroll))
		self.scrollBar.Hide()

		# Setup close button event
		self.board.SetCloseEvent(ui.__mem_func__(self.Close))

		# Setup clear button event
		self.btnClear.SetEvent(ui.__mem_func__(self.OnClickClear))

		self.Hide()

	def _CreateHeaderBar(self):
		"""Create header bar with column labels."""
		isArabic = localeinfo.IsARABIC() if hasattr(localeinfo, "IsARABIC") else False

		# Header dimensions from the script (LIST_WIDTH = 390)
		HEADER_WIDTH = 390

		# Header background using ThinBoard for consistent UI look
		self.headerBoard = ui.OutlineWindow()
		self.headerBoard.SetParent(self.headerBg)
		self.headerBoard.MakeOutlineWindow(HEADER_WIDTH - 15, self.HEADER_HEIGHT + 3)
		self.headerBoard.SetPosition(4, 0)
		self.headerBoard.Show()

		# Column labels
		typeLabel = localeinfo.NOTIFICATION_HISTORY_COL_TYPE if hasattr(localeinfo, "NOTIFICATION_HISTORY_COL_TYPE") else "Type"
		notifLabel = localeinfo.NOTIFICATION_HISTORY_COL_NOTIFICATION if hasattr(localeinfo, "NOTIFICATION_HISTORY_COL_NOTIFICATION") else "Notification"
		timeLabel = localeinfo.NOTIFICATION_HISTORY_COL_TIME if hasattr(localeinfo, "NOTIFICATION_HISTORY_COL_TIME") else "Time"

		if isArabic:
			# RTL layout: [Time] [Notification] [Type]
			self.labelTime = ui.TextLine()
			self.labelTime.SetParent(self.headerBoard)
			self.labelTime.SetPosition(55, 4)
			self.labelTime.SetText(timeLabel)
			self.labelTime.SetPackedFontColor(0xFF888888)
			self.labelTime.SetOutline()
			self.labelTime.Show()

			self.labelNotification = ui.TextLine()
			self.labelNotification.SetParent(self.headerBoard)
			self.labelNotification.SetPosition(295 - 90, 5)
			self.labelNotification.SetText(notifLabel)
			self.labelNotification.SetPackedFontColor(0xFF888888)
			self.labelNotification.SetOutline()
			self.labelNotification.Show()

			self.labelType = ui.TextLine()
			self.labelType.SetParent(self.headerBoard)
			self.labelType.SetPosition(350, 5)
			self.labelType.SetText(typeLabel)
			self.labelType.SetPackedFontColor(0xFF888888)
			self.labelType.SetOutline()
			self.labelType.Show()
		else:
			# LTR layout: [Type] [Notification] [Time]
			self.labelType = ui.TextLine()
			self.labelType.SetParent(self.headerBoard)
			self.labelType.SetPosition(self.COL_TYPE_X + 5, 5)
			self.labelType.SetText(typeLabel)
			self.labelType.SetPackedFontColor(0xFF888888)
			self.labelType.SetOutline()
			self.labelType.Show()

			self.labelNotification = ui.TextLine()
			self.labelNotification.SetParent(self.headerBoard)
			self.labelNotification.SetPosition(self.COL_NOTIF_X, 5)
			self.labelNotification.SetText(notifLabel)
			self.labelNotification.SetPackedFontColor(0xFF888888)
			self.labelNotification.SetOutline()
			self.labelNotification.Show()

			self.labelTime = ui.TextLine()
			self.labelTime.SetParent(self.headerBoard)
			self.labelTime.SetPosition(self.COL_TIME_X, 5)
			self.labelTime.SetText(timeLabel)
			self.labelTime.SetPackedFontColor(0xFF888888)
			self.labelTime.SetOutline()
			self.labelTime.Show()

	def SetItemToolTip(self, tooltip):
		self.tooltipItem = tooltip

	def Open(self):
		"""Open and refresh the history window."""
		self.Refresh()
		self.Show()
		self.SetTop()

	def Close(self):
		"""Close the history window."""
		if self.tooltipItem:
			self.tooltipItem.HideToolTip()
		self.Hide()

	def Refresh(self):
		"""Rebuild list from NotificationCenter history."""
		self.Clear()

		center = NotificationCenter.GetInstance()
		if not center:
			self.emptyText.Show()
			return

		history = center.GetHistory()
		if not history or len(history) == 0:
			self.emptyText.Show()
			return

		self.emptyText.Hide()

		# Create items for each notification (up to MAX_HISTORY)
		for i, notif in enumerate(history[:self.MAX_HISTORY]):
			histItem = NotificationHistoryItem()
			histItem.SetParent(self.listContainer)
			histItem.SetData(notif)
			histItem.SetItemToolTip(self.tooltipItem)
			self.historyItems.append(histItem)

		self.RefreshPositions()
		self.UpdateScrollBar()

	def Clear(self):
		"""Clear displayed items."""
		for histItem in self.historyItems:
			histItem.Hide()
			histItem.Destroy()
		self.historyItems = []
		self.basePos = 0

	def RefreshPositions(self):
		"""Update visibility and positions based on scroll."""
		yPos = 0
		for i, histItem in enumerate(self.historyItems):
			if i < self.basePos:
				histItem.Hide()
			elif i < self.basePos + self.VISIBLE_ITEMS:
				histItem.SetPosition(0, yPos)
				histItem.Show()
				yPos += self.ITEM_HEIGHT
			else:
				histItem.Hide()

	def UpdateScrollBar(self):
		"""Show/hide scrollbar based on item count."""
		if len(self.historyItems) <= self.VISIBLE_ITEMS:
			self.scrollBar.Hide()
		else:
			self.scrollBar.Show()

	def OnScroll(self):
		"""Handle scroll position change."""
		if not self.scrollBar:
			return
		pos = self.scrollBar.GetPos()
		maxScroll = max(0, len(self.historyItems) - self.VISIBLE_ITEMS)
		self.basePos = int(pos * maxScroll)
		self.RefreshPositions()

	def OnMouseWheel(self, nLen):
		"""Handle mouse wheel for scrolling."""
		if nLen > 0:
			self.scrollBar.OnUp()
		else:
			self.scrollBar.OnDown()

	def OnClickClear(self):
		"""Handle clear button click."""
		center = NotificationCenter.GetInstance()
		if center:
			center.ClearHistory()
		self.Refresh()

	def OnUpdate(self):
		"""Periodically update relative times."""
		currentTime = app.GetGlobalTimeStamp()
		if currentTime - self.lastTimeUpdate >= self.TIME_UPDATE_INTERVAL:
			self.lastTimeUpdate = currentTime
			for histItem in self.historyItems:
				histItem.UpdateTime()

	def Destroy(self):
		self.Clear()
		if self.tooltipItem:
			self.tooltipItem = None
		if self.scrollBar:
			self.scrollBar = None

	def OnPressEscapeKey(self):
		self.Close()
		return True


class NotificationCenter:
	"""
	Singleton notification manager.
	Other systems (Python-side) can use this to add notifications.
	Server sends notifications via BINARY_NotificationReceived callback.

	Uses module-level _g_notificationHistory for persistence across warps/logout.
	History is only cleared when game client fully exits or user manually clears.

	Manages up to MAX_VISIBLE_POPUPS stacked notifications simultaneously.
	When all slots are full, new notifications queue until a slot becomes available.
	"""

	_instance = None
	MAX_HISTORY = 20           # Max items to keep in history
	MAX_VISIBLE_POPUPS = 3     # Max simultaneous popup notifications

	def __init__(self):
		global _g_maxHistory
		NotificationCenter._instance = self

		# Create pool of popup instances for stacking
		self.popups = []
		for i in range(self.MAX_VISIBLE_POPUPS):
			popup = NotificationPopup(slotIndex=i, onCloseCallback=ui.__mem_func__(self._OnPopupClosed))
			self.popups.append(popup)

		# Queue for notifications waiting for an available slot
		self.pendingQueue = []

		# Use module-level storage instead of instance-level for persistence
		self.maxHistory = _g_maxHistory
		self.interface = None
		self.historyWindow = None
		self.tooltipItem = None

	@staticmethod
	def GetInstance():
		"""Get singleton instance."""
		return NotificationCenter._instance

	def SetInterface(self, interface):
		"""
		Set reference to interface module for opening windows on click.
		Called from interfacemodule.py after initialization.
		"""
		self.interface = interface
		for popup in self.popups:
			popup.SetInterface(interface)

	def SetItemToolTip(self, tooltip):
		"""Set tooltip for history window (stored for lazy creation)."""
		self.tooltipItem = tooltip
		if self.historyWindow:
			self.historyWindow.SetItemToolTip(tooltip)

	def AddNotification(self, notificationType, **kwargs):
		"""
		Add a notification to the queue.

		With stacked notifications, this will:
		1. Try to find an available popup slot
		2. If found, display immediately
		3. If all slots full, add to pending queue

		Args:
			notificationType: NotificationType enum value
			**kwargs:
				item_vnum: Item VNUM (for item-based notifications, enables tooltip)
				item_count: Item count
				icon_path: Custom icon path (for non-item notifications)
				title: Notification title (generated if empty)
				message: Notification message (generated if empty)

		Returns:
			int: Notification ID
		"""
		global _g_notificationHistory

		notification = {
			"id": app.GetGlobalTimeStamp(),
			"type": notificationType,
			"timestamp": app.GetGlobalTimeStamp(),
			"item_vnum": kwargs.get("item_vnum", 0),
			"item_count": kwargs.get("item_count", 1),
			"icon_path": kwargs.get("icon_path", ""),
			"title": kwargs.get("title", ""),
			"message": kwargs.get("message", ""),
		}

		# Try to assign to an available popup slot immediately
		assigned = self._AssignToAvailableSlot(notification)
		if not assigned:
			# All slots full, add to pending queue
			self.pendingQueue.append(notification)

		# Add to module-level history (newest first) - persists across warp/logout
		_g_notificationHistory.insert(0, notification)
		if len(_g_notificationHistory) > self.maxHistory:
			_g_notificationHistory.pop()  # Remove oldest

		# Refresh history window if open
		if self.historyWindow and self.historyWindow.IsShow():
			self.historyWindow.Refresh()

		return notification["id"]

	def _AssignToAvailableSlot(self, notification):
		"""
		Try to assign notification to an available popup slot.
		Returns True if assigned, False if all slots are full.
		"""
		for popup in self.popups:
			if popup.IsAvailable():
				popup.ShowNotification(notification)
				return True
		return False

	def _OnPopupClosed(self, slotIndex, closedNotification):
		"""
		Callback when a popup notification is dismissed.
		Assigns pending notification to the freed slot if available.
		"""
		# If there are pending notifications, show in the slot that just freed up
		if self.pendingQueue:
			notification = self.pendingQueue.pop(0)
			self.popups[slotIndex].ShowNotification(notification)

	def GetHistory(self):
		"""Get notification history list from module-level storage."""
		global _g_notificationHistory
		return _g_notificationHistory

	def ClearHistory(self):
		"""Clear notification history (user-initiated)."""
		global _g_notificationHistory
		_g_notificationHistory = []

	def ShowHistory(self):
		"""Show the history window."""
		if not self.historyWindow:
			self.historyWindow = NotificationHistoryWindow()
			# Use stored tooltipItem, or fallback to interface.tooltipItem
			if self.tooltipItem:
				self.historyWindow.SetItemToolTip(self.tooltipItem)
			elif hasattr(self, 'interface') and self.interface and hasattr(self.interface, 'tooltipItem'):
				self.historyWindow.SetItemToolTip(self.interface.tooltipItem)
		self.historyWindow.Open()

	def HideHistory(self):
		"""Hide the history window."""
		if self.historyWindow:
			self.historyWindow.Close()

	def ToggleHistory(self):
		"""Toggle history window visibility."""
		if not self.historyWindow:
			self.ShowHistory()
		elif self.historyWindow.IsShow():
			self.HideHistory()
		else:
			self.ShowHistory()

	def Destroy(self):
		"""Cleanup UI elements on shutdown - preserves history for session persistence."""
		for popup in self.popups:
			popup.Destroy()
		self.popups = []
		self.pendingQueue = []
		if self.historyWindow:
			self.historyWindow.Destroy()
			self.historyWindow = None
		# NOTE: Do NOT clear _g_notificationHistory here
		# History should persist across warp/logout until game client fully exits
		NotificationCenter._instance = None
